# CareerPilot AI Backend Environment Configuration
# Copy this file to .env or set environment variables in your deployment / container runtime.

# Application Server
PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=careerpilot_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_postgres_password_here

# Full connection string alternative (if using hosted Supabase / Neon / RDS)
# DB_URL=jdbc:postgresql://ep-example.us-east-2.aws.neon.tech/careerpilot_db?sslmode=require

# CORS Allowed Origins (Comma-separated for local React Vite frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# JWT Security Configuration
# Secret key must be a secure, random string at least 256 bits (32+ bytes) long for HMAC-SHA256
JWT_SECRET=your_secure_random_256_bit_jwt_secret_change_in_production
JWT_EXPIRATION_MS=86400000

# AI Resume Improvement Provider Configuration (Phase 5)
# Set AI_ENABLED=true to enable external LLM recommendations. Defaults to false.
AI_ENABLED=false
# Provider name: 'gemini' (default, official Google Generative Language API) or 'openai' (compatible with OpenAI, Groq, OpenRouter)
AI_PROVIDER=gemini
# API Key for Google Gemini. You can set GEMINI_API_KEY or AI_API_KEY. Never commit secrets to Git or expose to frontend.
GEMINI_API_KEY=
AI_API_KEY=
# LLM Model identifier (configurable via AI_MODEL):
# For Gemini: gemini-3.8-flash (default), gemini-2.5-flash, or gemini-2.0-flash
# For OpenAI: gpt-4o-mini, gpt-4o, etc.
AI_MODEL=gemini-3.8-flash
# Optional Fallback Model (only invoked if primary model fails with transient 503/429/timeout after all retries):
# Example: gemini-2.0-flash or gemini-1.5-flash
AI_FALLBACK_MODEL=
# Provider Base URL:
# For Gemini: https://generativelanguage.googleapis.com/v1beta (default)
# For OpenAI: https://api.openai.com/v1
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Client connect and read timeouts (milliseconds)
AI_CONNECT_TIMEOUT_MS=10000
AI_READ_TIMEOUT_MS=30000
# User rate limiting: maximum improvement requests per user per minute
AI_RATE_LIMIT_PER_MINUTE=5
# Bounded transient retry configuration (HTTP 429, 500, 502, 503, 504 and timeouts with exponential backoff & jitter)
AI_MAX_RETRIES=3
AI_RETRY_INITIAL_BACKOFF_MS=1000
AI_RETRY_MAX_BACKOFF_MS=8000

