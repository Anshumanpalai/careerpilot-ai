# CareerPilot AI — Frontend Environment Configuration
#
# LOCAL DEVELOPMENT:
# Leave as /api/v1 so the Vite dev server proxies requests to http://localhost:8080
VITE_API_BASE_URL=/api/v1

# VERCEL / PRODUCTION DEPLOYMENT:
# In Vercel Project Settings > Environment Variables, set VITE_API_BASE_URL to your deployed backend URL:
# Example: VITE_API_BASE_URL=https://careerpilot-backend.up.railway.app/api/v1
# (Or https://your-backend-service.onrender.com/api/v1)
#
# NOTE: In your backend environment (Railway, Render, Fly.io, etc.), configure:
# CORS_ALLOWED_ORIGINS=https://your-careerpilot-app.vercel.app
